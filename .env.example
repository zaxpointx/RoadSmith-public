# Roadsmith — environment variables
# Copy to .env.local and fill in real values. Never commit real secrets.

# ── Supabase ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SEED_SECRET=

# ── Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Reserved: not read by application code yet.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
# Reserved: not read by application code yet.
STRIPE_GROWTH_PRICE_ID=

# ── Google Calendar OAuth (ROA-18) ────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_CALENDAR_REDIRECT_URI below.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/google-calendar/callback
# ── Application ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false
DEMO_SCHOOL_ID=00000000-0000-0000-0000-000000000000
CONTACT_EMAIL=support@example.com
SUPPORT_EMAIL=support@example.com

# ── Server-only security and jobs ─────────────────────────────────
# Leave these empty locally until you have approved development-only values.
SUPABASE_JWT_SECRET=
ENCRYPTION_KEY=
RESEND_API_KEY=
CRON_SECRET=
NODE_ENV=development

# ── Roadsmith OS (the text-message assistant + Control Center) ─────
# Leave DATABASE_URL empty to run the local sandbox (PGlite under .roadsmith/,
# seeded with a fictional school). Set it to a Postgres/Supabase connection
# string for a real deployment, after applying supabase/migrations/.
DATABASE_URL=
# Required whenever DATABASE_URL is set: signs Control Center session cookies.
ROADSMITH_SESSION_SECRET=
# Optional: where the sandbox database lives (default .roadsmith/sandbox-db).
ROADSMITH_SANDBOX_DIR=

# Conversation engine. Without a key, a narrower built-in interpreter replies.
ANTHROPIC_API_KEY=
# Alternative to an API key (OAuth token); either one enables Claude.
ANTHROPIC_AUTH_TOKEN=
ROADSMITH_AGENT_MODEL=claude-opus-5-5
ROADSMITH_AGENT_EFFORT=low
# Force 'interpreter' even when a key is set (tests, cost control).
ROADSMITH_AGENT_ENGINE=

# SMS (Twilio). Without these, texts stay in the sandbox outbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The exact public URL configured in Twilio for inbound messages (used for signature checks).
TWILIO_WEBHOOK_URL=

# Payments: STRIPE_SECRET_KEY above. sk_test_ keys route payments to Stripe Checkout;
# sk_live_ keys are refused unless this is set to 1.
ROADSMITH_ALLOW_LIVE_PAYMENTS=
# Signing secret for /api/os/stripe/webhook (falls back to STRIPE_WEBHOOK_SECRET).
ROADSMITH_STRIPE_WEBHOOK_SECRET=

# Local e2e only: path to a preinstalled Chromium if Playwright's own isn't downloaded.
PLAYWRIGHT_CHROMIUM_PATH=
