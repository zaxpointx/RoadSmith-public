# Roadsmith — environment variables
# Copy to .env.local and fill in real values. Never commit real secrets.

# ── Supabase ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SEED_SECRET=

# ── Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=

# ── Google Calendar OAuth (ROA-18) ────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_CALENDAR_REDIRECT_URI below.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/google-calendar/callback
# ── Application ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false
DEMO_SCHOOL_ID=00000000-0000-0000-0000-000000000000
CONTACT_EMAIL=support@example.com
SUPPORT_EMAIL=support@example.com

# ── Server-only security and jobs ─────────────────────────────────
# Leave these empty locally until you have approved development-only values.
SUPABASE_JWT_SECRET=
ENCRYPTION_KEY=
RESEND_API_KEY=
CRON_SECRET=
NODE_ENV=development
